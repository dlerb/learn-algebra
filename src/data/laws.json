[
  {
    "id": "thm.minus-over-sum",
    "code": "T4",
    "kind": "theorem",
    "group": "signs",
    "name": {
      "en": "Minus over a sum",
      "de": "Minus vor einer Summe"
    },
    "latex": "-(a + b) = -a - b, \\quad -(a - b) = b - a",
    "derivedFrom": [
      "th.negative-one-times",
      "ax.distributivity",
      "def.sub"
    ]
  },
  {
    "id": "thm.subtract-a-sum",
    "code": "T6",
    "kind": "theorem",
    "group": "signs",
    "name": {
      "en": "Subtracting a sum",
      "de": "Eine Summe subtrahieren"
    },
    "latex": "a - (b + c) = a - b - c, \\quad a - (b - c) = a - b + c",
    "derivedFrom": [
      "def.sub",
      "thm.minus-over-sum",
      "ax.add-associative"
    ]
  },
  {
    "id": "thm.collect-like-terms",
    "code": "T7",
    "kind": "theorem",
    "group": "distribution",
    "name": {
      "en": "Collecting like terms",
      "de": "Gleichartige Terme zusammenfassen"
    },
    "latex": "na + ma = (n + m)a",
    "derivedFrom": [
      "ax.distributivity",
      "ax.mul-commutative",
      "def.multiple"
    ],
    "note": {
      "en": "Distributivity read backwards.",
      "de": "Das Distributivgesetz rückwärts gelesen."
    }
  },
  {
    "id": "thm.split-numerator",
    "code": "T8",
    "kind": "theorem",
    "group": "fractions",
    "name": {
      "en": "Splitting the numerator",
      "de": "Den Zähler aufteilen"
    },
    "latex": "\\frac{a + b}{c} = \\frac{a}{c} + \\frac{b}{c}",
    "conditions": "c \\ne 0",
    "derivedFrom": [
      "def.div",
      "ax.distributivity"
    ],
    "note": {
      "en": "Over the numerator only — a sum in the denominator does not split.",
      "de": "Nur über den Zähler — eine Summe im Nenner lässt sich nicht aufteilen."
    }
  },
  {
    "id": "thm.fraction-sign-moves",
    "code": "T9",
    "kind": "theorem",
    "group": "fractions",
    "name": {
      "en": "The minus of a fraction moves",
      "de": "Das Minus eines Bruchs wandert"
    },
    "latex": "-\\frac{a}{b} = \\frac{-a}{b} = \\frac{a}{-b}",
    "conditions": "b \\ne 0",
    "derivedFrom": [
      "th.negative-one-times",
      "th.minus-times-minus",
      "th.opposite-flips",
      "def.div"
    ]
  },
  {
    "id": "thm.cancel-common-factor",
    "code": "T10",
    "kind": "theorem",
    "group": "fractions",
    "name": {
      "en": "Cancelling a common factor",
      "de": "Einen gemeinsamen Faktor kürzen"
    },
    "latex": "\\frac{ka}{kb} = \\frac{a}{b}",
    "conditions": "k \\ne 0, b \\ne 0",
    "derivedFrom": [
      "def.div",
      "ax.mul-associative",
      "ax.multiplicative-inverse"
    ]
  },
  {
    "id": "thm.power-same-base-quotient",
    "code": "T12",
    "kind": "theorem",
    "group": "powers",
    "name": {
      "en": "Same-base law, quotient form",
      "de": "Gleiche Basis, Quotientenform"
    },
    "latex": "\\frac{a^m}{a^n} = a^{m-n}",
    "conditions": "a \\ne 0",
    "derivedFrom": [
      "pl.same-base",
      "def.div",
      "def.pow-zero",
      "def.pow-neg"
    ],
    "note": {
      "en": "For m > n this is cancelling common factors; the general form needs the extended exponents.",
      "de": "Für m > n ist dies Kürzen gemeinsamer Faktoren; die allgemeine Form braucht die erweiterten Exponenten."
    }
  },
  {
    "id": "thm.power-of-quotient",
    "code": "T15",
    "kind": "theorem",
    "group": "powers",
    "name": {
      "en": "Same-exponent law, quotient form",
      "de": "Gleicher Exponent, Quotientenform"
    },
    "latex": "\\left(\\frac{a}{b}\\right)^n = \\frac{a^n}{b^n}",
    "conditions": "b \\ne 0",
    "derivedFrom": [
      "def.div",
      "pl.of-product"
    ]
  },
  {
    "id": "thm.root-of-product",
    "code": "T16",
    "kind": "theorem",
    "group": "roots",
    "name": {
      "en": "Root of a product (same-exponent law for roots)",
      "de": "Wurzel eines Produkts (gleicher Exponent für Wurzeln)"
    },
    "latex": "\\sqrt{ab} = \\sqrt{a} \\cdot \\sqrt{b}",
    "conditions": "a, b \\ge 0",
    "derivedFrom": [
      "def.root",
      "pl.of-product"
    ]
  },
  {
    "id": "thm.root-of-quotient",
    "code": "T17",
    "kind": "theorem",
    "group": "roots",
    "name": {
      "en": "Root of a quotient (same-exponent law for roots, quotient form)",
      "de": "Wurzel eines Quotienten (gleicher Exponent für Wurzeln, Quotientenform)"
    },
    "latex": "\\sqrt{\\frac{a}{b}} = \\frac{\\sqrt{a}}{\\sqrt{b}}",
    "conditions": "a \\ge 0, b > 0",
    "derivedFrom": [
      "def.root",
      "thm.power-of-quotient"
    ]
  },
  {
    "id": "thm.divide-by-one",
    "code": "T21",
    "kind": "theorem",
    "group": "fractions",
    "name": {
      "en": "Dividing by one and by itself",
      "de": "Division durch eins und durch sich selbst"
    },
    "latex": "\\frac{a}{1} = a, \\quad \\frac{a}{a} = 1",
    "conditions": "a \\ne 0 \\;(\\text{for } a/a)",
    "derivedFrom": [
      "def.div",
      "ax.one-neutral",
      "ax.multiplicative-inverse"
    ]
  },
  {
    "id": "thm.root-power-order",
    "code": "T22",
    "kind": "theorem",
    "group": "roots",
    "name": {
      "en": "Root and power commute (power-of-a-power law for roots)",
      "de": "Wurzel und Potenz vertauschbar (Potenz einer Potenz für Wurzeln)"
    },
    "latex": "\\sqrt[n]{a^m} = (\\sqrt[n]{a})^m",
    "conditions": "a > 0",
    "derivedFrom": [
      "def.root",
      "pl.of-power"
    ],
    "note": {
      "en": "The two readings of def.fractional-exponent agree — why equivalence.fractional-exponent-root lists both forms.",
      "de": "Die beiden Lesarten von def.fractional-exponent stimmen überein — darum führt equivalence.fractional-exponent-root beide Formen auf."
    }
  }
]
