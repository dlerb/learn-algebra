[
  { "id": "ax.add-commutative", "code": "A1", "sort": "axiom",
    "name": { "en": "Commutativity of addition", "de": "Kommutativgesetz der Addition" },
    "latex": "a + b = b + a" },
  { "id": "ax.add-associative", "code": "A2", "sort": "axiom",
    "name": { "en": "Associativity of addition", "de": "Assoziativgesetz der Addition" },
    "latex": "(a + b) + c = a + (b + c)" },
  { "id": "ax.zero-neutral", "code": "A3", "sort": "axiom",
    "name": { "en": "Zero is neutral", "de": "Null ist neutral" },
    "latex": "a + 0 = a" },
  { "id": "ax.additive-inverse", "code": "A4", "sort": "axiom",
    "name": { "en": "Additive inverse (the opposite)", "de": "Additives Inverses (die Gegenzahl)" },
    "latex": "a + (-a) = 0" },
  { "id": "ax.mul-commutative", "code": "A5", "sort": "axiom",
    "name": { "en": "Commutativity of multiplication", "de": "Kommutativgesetz der Multiplikation" },
    "latex": "ab = ba" },
  { "id": "ax.mul-associative", "code": "A6", "sort": "axiom",
    "name": { "en": "Associativity of multiplication", "de": "Assoziativgesetz der Multiplikation" },
    "latex": "(ab)c = a(bc)" },
  { "id": "ax.one-neutral", "code": "A7", "sort": "axiom",
    "name": { "en": "One is neutral", "de": "Eins ist neutral" },
    "latex": "1 \\cdot a = a" },
  { "id": "ax.multiplicative-inverse", "code": "A8", "sort": "axiom",
    "name": { "en": "Multiplicative inverse (the reciprocal)", "de": "Multiplikatives Inverses (der Kehrwert)" },
    "latex": "a \\cdot \\frac{1}{a} = 1", "conditions": "a \\ne 0" },
  { "id": "ax.distributivity", "code": "A9", "sort": "axiom",
    "name": { "en": "Distributivity", "de": "Distributivgesetz" },
    "latex": "a(b + c) = ab + ac",
    "note": { "en": "The only bridge between the addition world and the multiplication world.",
              "de": "Die einzige Brücke zwischen der Additions- und der Multiplikationswelt." } },

  { "id": "def.subtraction", "code": "D1", "sort": "definition",
    "name": { "en": "Subtraction", "de": "Subtraktion" },
    "latex": "a - b := a + (-b)",
    "basedOn": ["ax.additive-inverse"],
    "note": { "en": "Subtraction is not a new operation: it is adding the inverse.",
              "de": "Die Subtraktion ist keine neue Operation: sie ist Addition der Gegenzahl." } },
  { "id": "def.division", "code": "D2", "sort": "definition",
    "name": { "en": "Division", "de": "Division" },
    "latex": "\\frac{a}{b} := a \\cdot \\frac{1}{b}", "conditions": "b \\ne 0",
    "basedOn": ["ax.multiplicative-inverse"],
    "note": { "en": "Division is not a new operation: it is multiplying by the reciprocal.",
              "de": "Die Division ist keine neue Operation: sie ist Multiplikation mit dem Kehrwert." } },
  { "id": "def.integer-multiple", "code": "D3", "sort": "definition",
    "name": { "en": "Multiple as repeated addition", "de": "Vielfaches als wiederholte Addition" },
    "latex": "n \\cdot a := \\underbrace{a + a + \\ldots + a}_{n}",
    "note": { "en": "Definition by decision: provable from distributivity in a field, but school treats it as the meaning of $na$.",
              "de": "Definition per Entscheid: im Körper aus dem Distributivgesetz beweisbar, in der Schule aber die Bedeutung von $na$." } },
  { "id": "def.power", "code": "D4", "sort": "definition",
    "name": { "en": "Power as repeated multiplication", "de": "Potenz als wiederholte Multiplikation" },
    "latex": "a^n := \\underbrace{a \\cdot a \\cdot \\ldots \\cdot a}_{n}" },
  { "id": "def.root", "code": "D5", "sort": "definition",
    "name": { "en": "Root", "de": "Wurzel" },
    "latex": "b = \\sqrt{a} \\;:\\Leftrightarrow\\; b \\ge 0 \\text{ and } b^2 = a", "conditions": "a \\ge 0",
    "basedOn": ["def.power"],
    "note": { "en": "The n-th root is defined likewise via $b^n = a$.",
              "de": "Die n-te Wurzel ist analog über $b^n = a$ definiert." } },
  { "id": "def.extended-exponents", "code": "D6", "sort": "definition",
    "name": { "en": "Extended exponents (zero and negative)", "de": "Erweiterte Exponenten (null und negativ)" },
    "latex": "a^0 := 1, \\quad a^{-n} := \\frac{1}{a^n}", "conditions": "a \\ne 0",
    "basedOn": ["def.power", "thm.power-same-base"],
    "note": { "en": "Extension by permanence: chosen so the same-base law survives — contrast thm.zero-product, which is forced.",
              "de": "Erweiterung nach dem Permanenzprinzip: so gewählt, dass die Gleiche-Basis-Regel erhalten bleibt — im Gegensatz zu thm.zero-product, das erzwungen ist." } },
  { "id": "def.fractional-exponent", "code": "D7", "sort": "definition",
    "name": { "en": "Fractional exponent", "de": "Gebrochener Exponent" },
    "latex": "a^{m/n} := \\sqrt[n]{a^m}", "conditions": "a > 0",
    "basedOn": ["def.power", "def.root"],
    "note": { "en": "Extension by permanence, second step; that this equals $(\\sqrt[n]{a})^m$ is thm.root-power-order.",
              "de": "Erweiterung nach dem Permanenzprinzip, zweiter Schritt; dass dies gleich $(\\sqrt[n]{a})^m$ ist, ist thm.root-power-order." } },

  { "id": "thm.zero-product", "code": "T1", "sort": "theorem",
    "name": { "en": "Zero times anything is zero", "de": "Null mal irgendetwas ist null" },
    "latex": "0 \\cdot a = 0",
    "derivedFrom": ["ax.distributivity", "ax.zero-neutral", "ax.additive-inverse"],
    "note": { "en": "Forced by the axioms ($0a = (0+0)a = 0a + 0a$), unlike $a^0 := 1$, which is chosen.",
              "de": "Von den Axiomen erzwungen ($0a = (0+0)a = 0a + 0a$), anders als $a^0 := 1$, das gewählt ist." } },
  { "id": "thm.negative-one-times", "code": "T2", "sort": "theorem",
    "name": { "en": "Minus one times a", "de": "Minus eins mal a" },
    "latex": "(-1) \\cdot a = -a",
    "derivedFrom": ["thm.zero-product", "ax.distributivity", "ax.one-neutral", "ax.additive-inverse"] },
  { "id": "thm.sign-rules", "code": "T3", "sort": "theorem",
    "name": { "en": "Sign rules", "de": "Vorzeichenregeln" },
    "latex": "(-a)b = -(ab), \\quad (-a)(-b) = ab",
    "derivedFrom": ["thm.negative-one-times", "ax.mul-commutative", "ax.mul-associative"] },
  { "id": "thm.minus-over-sum", "code": "T4", "sort": "theorem",
    "name": { "en": "Minus over a sum", "de": "Minus vor einer Summe" },
    "latex": "-(a + b) = -a - b, \\quad -(a - b) = b - a",
    "derivedFrom": ["thm.negative-one-times", "ax.distributivity", "def.subtraction"] },
  { "id": "thm.double-negative", "code": "T5", "sort": "theorem",
    "name": { "en": "Double negative", "de": "Doppeltes Minus" },
    "latex": "-(-a) = a, \\quad a - (-b) = a + b",
    "derivedFrom": ["ax.additive-inverse", "def.subtraction"] },
  { "id": "thm.subtract-a-sum", "code": "T6", "sort": "theorem",
    "name": { "en": "Subtracting a sum", "de": "Eine Summe subtrahieren" },
    "latex": "a - (b + c) = a - b - c, \\quad a - (b - c) = a - b + c",
    "derivedFrom": ["def.subtraction", "thm.minus-over-sum", "ax.add-associative"] },
  { "id": "thm.collect-like-terms", "code": "T7", "sort": "theorem",
    "name": { "en": "Collecting like terms", "de": "Gleichartige Terme zusammenfassen" },
    "latex": "na + ma = (n + m)a",
    "derivedFrom": ["ax.distributivity", "ax.mul-commutative", "def.integer-multiple"],
    "note": { "en": "Distributivity read backwards.", "de": "Das Distributivgesetz rückwärts gelesen." } },
  { "id": "thm.split-numerator", "code": "T8", "sort": "theorem",
    "name": { "en": "Splitting the numerator", "de": "Den Zähler aufteilen" },
    "latex": "\\frac{a + b}{c} = \\frac{a}{c} + \\frac{b}{c}", "conditions": "c \\ne 0",
    "derivedFrom": ["def.division", "ax.distributivity"],
    "note": { "en": "Over the numerator only — a sum in the denominator does not split.",
              "de": "Nur über den Zähler — eine Summe im Nenner lässt sich nicht aufteilen." } },
  { "id": "thm.fraction-sign-moves", "code": "T9", "sort": "theorem",
    "name": { "en": "The minus of a fraction moves", "de": "Das Minus eines Bruchs wandert" },
    "latex": "-\\frac{a}{b} = \\frac{-a}{b} = \\frac{a}{-b}", "conditions": "b \\ne 0",
    "derivedFrom": ["thm.negative-one-times", "thm.sign-rules", "def.division"] },
  { "id": "thm.cancel-common-factor", "code": "T10", "sort": "theorem",
    "name": { "en": "Cancelling a common factor", "de": "Einen gemeinsamen Faktor kürzen" },
    "latex": "\\frac{ka}{kb} = \\frac{a}{b}", "conditions": "k \\ne 0, b \\ne 0",
    "derivedFrom": ["def.division", "ax.mul-associative", "ax.multiplicative-inverse"] },
  { "id": "thm.power-same-base", "code": "T11", "sort": "theorem",
    "name": { "en": "Same-base law", "de": "Gleiche Basis" },
    "latex": "a^m \\cdot a^n = a^{m+n}",
    "derivedFrom": ["def.power"] },
  { "id": "thm.power-same-base-quotient", "code": "T12", "sort": "theorem",
    "name": { "en": "Same-base law, quotient form", "de": "Gleiche Basis, Quotientenform" },
    "latex": "\\frac{a^m}{a^n} = a^{m-n}", "conditions": "a \\ne 0",
    "derivedFrom": ["thm.power-same-base", "def.division", "def.extended-exponents"],
    "note": { "en": "For m > n this is cancelling common factors; the general form needs the extended exponents.",
              "de": "Für m > n ist dies Kürzen gemeinsamer Faktoren; die allgemeine Form braucht die erweiterten Exponenten." } },
  { "id": "thm.power-of-power", "code": "T13", "sort": "theorem",
    "name": { "en": "Power-of-a-power law", "de": "Potenz einer Potenz" },
    "latex": "(a^m)^n = a^{mn}",
    "derivedFrom": ["def.power"] },
  { "id": "thm.power-same-exponent", "code": "T14", "sort": "theorem",
    "name": { "en": "Same-exponent law", "de": "Gleicher Exponent" },
    "latex": "(ab)^n = a^n b^n",
    "derivedFrom": ["def.power", "ax.mul-commutative", "ax.mul-associative"] },
  { "id": "thm.power-of-quotient", "code": "T15", "sort": "theorem",
    "name": { "en": "Same-exponent law, quotient form", "de": "Gleicher Exponent, Quotientenform" },
    "latex": "\\left(\\frac{a}{b}\\right)^n = \\frac{a^n}{b^n}", "conditions": "b \\ne 0",
    "derivedFrom": ["def.division", "thm.power-same-exponent"] },
  { "id": "thm.root-of-product", "code": "T16", "sort": "theorem",
    "name": { "en": "Root of a product (same-exponent law for roots)", "de": "Wurzel eines Produkts (gleicher Exponent für Wurzeln)" },
    "latex": "\\sqrt{ab} = \\sqrt{a} \\cdot \\sqrt{b}", "conditions": "a, b \\ge 0",
    "derivedFrom": ["def.root", "thm.power-same-exponent"] },
  { "id": "thm.root-of-quotient", "code": "T17", "sort": "theorem",
    "name": { "en": "Root of a quotient (same-exponent law for roots, quotient form)", "de": "Wurzel eines Quotienten (gleicher Exponent für Wurzeln, Quotientenform)" },
    "latex": "\\sqrt{\\frac{a}{b}} = \\frac{\\sqrt{a}}{\\sqrt{b}}", "conditions": "a \\ge 0, b > 0",
    "derivedFrom": ["def.root", "thm.power-of-quotient"] },
  { "id": "thm.binomial-square", "code": "T18", "sort": "theorem",
    "name": { "en": "Binomial square", "de": "Binomische Formel (Quadrat)" },
    "latex": "(a + b)^2 = a^2 + 2ab + b^2",
    "derivedFrom": ["def.power", "ax.distributivity", "ax.add-commutative", "thm.collect-like-terms"] },
  { "id": "thm.difference-of-squares", "code": "T19", "sort": "theorem",
    "name": { "en": "Difference of squares", "de": "Dritte binomische Formel" },
    "latex": "(a + b)(a - b) = a^2 - b^2",
    "derivedFrom": ["ax.distributivity", "def.subtraction", "thm.sign-rules", "ax.add-commutative"] },
  { "id": "thm.divide-by-one", "code": "T20", "sort": "theorem",
    "name": { "en": "Dividing by one and by itself", "de": "Division durch eins und durch sich selbst" },
    "latex": "\\frac{a}{1} = a, \\quad \\frac{a}{a} = 1", "conditions": "a \\ne 0 \\;(\\text{for } a/a)",
    "derivedFrom": ["def.division", "ax.one-neutral", "ax.multiplicative-inverse"] },
  { "id": "thm.root-power-order", "code": "T21", "sort": "theorem",
    "name": { "en": "Root and power commute (power-of-a-power law for roots)", "de": "Wurzel und Potenz vertauschbar (Potenz einer Potenz für Wurzeln)" },
    "latex": "\\sqrt[n]{a^m} = (\\sqrt[n]{a})^m", "conditions": "a > 0",
    "derivedFrom": ["def.root", "thm.power-of-power"],
    "note": { "en": "The two readings of def.fractional-exponent agree — why notation.fractional-exponent-root lists both forms.",
              "de": "Die beiden Lesarten von def.fractional-exponent stimmen überein — darum führt notation.fractional-exponent-root beide Formen auf." } }
]
