      "conv.fraction-bar"
    ],
    "errors": [
      "mis.minus-roles-confused"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.subtracting-a-sum",
    "group": "minus-sign",
    "title": "Subtracting a bracketed sum",
    "note": "The minus hits every term inside, not just the first: a - (b+c) = a - b - c. Same rule as -(b+c), with a term in front.",
