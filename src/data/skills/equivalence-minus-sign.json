[
  {
    "kind": "equivalence",
    "id": "equivalence.negative-numbers",
    "group": "minus-sign",
    "title": "Negative numbers and the unary minus",
    "note": "A negative number and its parenthesised form are the same object: -3 and (-3) are identical, and both equal 0 - 3.",
    "illustration": "-3 = (-3) = 0 - 3",
    "metaPatterns": [
      "meta.three-minuses"
    ],
    "justifiedBy": [
      "def.subtraction"
    ],
    "governedBy": [
      "conv.minus-roles"
    ],
    "errors": [
      "anti.commute-everything"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.subtraction-as-adding-opposite",
    "group": "minus-sign",
    "title": "Subtracting vs. adding a negative",
    "note": "Subtracting is the same as adding the opposite: a - b = a + (-b). The minus and the number belong together.",
    "illustration": "a - b = a + (-b) = a + (-1) \\cdot b",
    "requires": [
      "equivalence.coefficient-negative-one"
    ],
    "metaPatterns": [
      "meta.three-minuses"
    ],
    "justifiedBy": [
      "def.subtraction",
      "thm.negative-one-times"
    ],
    "governedBy": [
      "conv.minus-roles"
    ],
    "errors": [
      "mis.minus-roles-confused"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.minus-over-sum",
    "group": "minus-sign",
    "title": "Distributing a negative over a sum",
    "note": "The minus distributes to every term inside: -(a+b) = -a - b, not -a + b.",
    "illustration": "-(a + b) = -a - b",
    "requires": [
      "equivalence.coefficient-negative-one"
    ],
    "metaPatterns": [
      "meta.three-minuses",
      "meta.implicit-op-before-bracket"
    ],
    "justifiedBy": [
      "thm.minus-over-sum"
    ],
    "governedBy": [
      "conv.minus-roles",
      "conv.brackets-group"
    ],
    "errors": [
      "anti.partial-distribution",
      "mis.minus-roles-confused"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.minus-over-difference",
    "group": "minus-sign",
    "title": "Distributing a negative over a difference",
    "note": "The minus flips the sign of every term inside the bracket. -(a-b) = -a+b, not -a-b.",
    "illustration": "-(a - b) = -a + b = b - a",
    "requires": [
      "equivalence.coefficient-negative-one"
    ],
    "metaPatterns": [
      "meta.three-minuses",
      "meta.implicit-op-before-bracket"
    ],
    "justifiedBy": [
      "thm.minus-over-sum"
    ],
    "governedBy": [
      "conv.minus-roles",
      "conv.brackets-group"
    ],
    "errors": [
      "anti.partial-distribution"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.double-negative",
    "group": "minus-sign",
    "title": "Double negative",
    "note": "Two minuses make a plus: subtracting a negative adds. a-(-b) = a+b, not a-b. (Likewise -(-a) = a.)",
    "illustration": "a - (-b) = a + b",
    "requires": [
      "equivalence.subtraction-as-adding-opposite"
    ],
    "metaPatterns": [
      "meta.three-minuses"
    ],
    "justifiedBy": [
      "thm.double-negative"
    ],
    "governedBy": [
      "conv.minus-roles"
    ],
    "errors": [
      "mis.minus-roles-confused"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.negative-times-negative",
    "group": "minus-sign",
    "title": "Negative times negative",
    "note": "A negative times a negative is positive: (-a)(-b) = ab, not -ab. (One negative factor gives a negative: (-a)(b) = -ab.)",
    "illustration": "(-a)(-b) = ab",
    "requires": [
