{
  "kind": "equivalence",
  "title": {
    "en": "Equivalence",
    "de": "Gleichwertigkeit"
  },
  "blurb": {
    "en": "Same thing written differently — the fluency atoms.",
    "de": "Dasselbe, anders geschrieben — die kleinsten Einheiten der Sicherheit."
  },
  "groups": [
    {
      "slug": "multiplication",
      "title": {
        "en": "Multiplication Notation",
        "de": "Schreibweisen der Multiplikation"
      },
      "skills": [
        {
          "id": "equivalence.explicit-vs-implicit-product",
          "name": {
            "en": "Explicit vs. implicit multiplication",
            "de": "Explizite und implizite Multiplikation"
          },
          "note": {
            "en": "Symbols next to each other, or joined by $\\cdot$ or $\\times$, all mean multiply. $3x$ is a product, not a two-digit number.",
            "de": "Zeichen nebeneinander, oder mit $\\cdot$ oder $\\times$ verbunden, bedeuten alle mal. $3x$ ist ein Produkt, keine zweistellige Zahl."
          },
          "illustration": "3 \\times x = 3 \\cdot x = 3x = x \\cdot 3 = (3)(x)",
          "wrong": [
            {
              "latex": "3x = 3 + x",
              "explains": "mis.juxtaposition-as-plus"
            }
          ],
          "rules": [
            "rule.juxtaposition"
          ],
          "restsOn": [
            "ix.juxtaposition",
            "ix.coefficient-front"
          ]
        },
        {
          "id": "equivalence.product-with-brackets",
          "name": {
            "en": "Multiplication with brackets",
            "de": "Multiplikation mit Klammern"
          },
          "note": {
            "en": "A number against a bracket means multiply: $2(x+1)$ is 2 times $(x+1)$.",
            "de": "Eine Zahl direkt vor einer Klammer heisst mal: $2(x+1)$ ist 2 mal $(x+1)$."
          },
          "illustration": "2 \\times (x+1) = 2 \\cdot (x+1) = 2(x+1) = (x+1) \\cdot 2",
          "wrong": [
            {
              "latex": "2(x+1) = 2 + (x+1)",
              "explains": "mis.juxtaposition-as-plus"
            }
          ],
          "requires": [
            "equivalence.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.juxtaposition",
            "rule.implicit-op-before-bracket"
          ],
          "restsOn": [
            "ix.juxtaposition",
            "ix.brackets"
          ]
        },
        {
          "id": "equivalence.coefficient-negative-one",
          "name": {
            "en": "Coefficient of -1",
            "de": "Koeffizient -1"
          },
          "note": {
            "en": "An invisible coefficient of -1 means negate: (-1)a, -1a and -a are the same object. (Similarly a coefficient of 1 is invisible: 1x = x.)",
            "de": "Ein unsichtbarer Koeffizient $-1$ bedeutet negieren: $(-1)a$, $-1a$ und $-a$ sind dasselbe. (Ebenso ist ein Koeffizient 1 unsichtbar: $1x = x$.)"
          },
          "illustration": "(-1) \\cdot a = (-1)a = -1a = -a",
          "wrong": [
            {
              "latex": "(-1)a = -1 + a",
              "explains": "mis.juxtaposition-as-plus"
            }
          ],
          "requires": [
            "equivalence.explicit-vs-implicit-product",
            "equivalence.negative-numbers"
          ],
          "rules": [
            "rule.juxtaposition",
            "rule.three-minuses"
          ],
          "restsOn": [
            "th.negative-one-times",
            "ix.invisible-one",
            "ix.juxtaposition"
          ]
        },
        {
          "id": "equivalence.coefficient-zero",
          "name": {
            "en": "Coefficient of 0",
            "de": "Koeffizient 0"
          },
          "note": {
            "en": "Zero times anything is zero: $0x = 0$, regardless of $x$.",
            "de": "Null mal irgendetwas ist null: $0x = 0$, ganz gleich, was $x$ ist."
          },
          "illustration": "0 \\cdot x = 0x = 0",
          "wrong": [
            {
              "latex": "0x = x",
              "explains": "mis.juxtaposition-as-plus"
            }
          ],
          "requires": [
            "equivalence.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.juxtaposition"
          ],
          "restsOn": [
            "th.zero-times",
            "ix.juxtaposition"
          ]
        },
        {
          "id": "equivalence.repeated-addition",
          "name": {
            "en": "Repeated addition vs. multiplication",
            "de": "Wiederholte Addition und Multiplikation"
          },
          "note": {
            "en": "Adding a term to itself scales it: $x + x = 2x$ (and $x+x+x = 3x$). Multiplying is what makes a power: $x \\cdot x = x^2$.",
            "de": "Einen Term zu sich selbst addieren vervielfacht ihn: $x + x = 2x$ (und $x+x+x = 3x$). Erst das Multiplizieren macht eine Potenz: $x \\cdot x = x^2$."
          },
          "illustration": "x + x = 2x",
          "wrong": [
            {
              "latex": "x + x = x^2",
              "explains": "anti.repetition-confusion"
            }
          ],
          "requires": [
            "equivalence.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.juxtaposition"
          ],
          "restsOn": [
            "def.multiple",
            "ix.juxtaposition"
          ]
        }
      ]
    },
    {
      "slug": "like-terms",
      "title": {
        "en": "Like & Unlike Terms",
        "de": "Gleichartige und ungleichartige Terme"
      },
      "blurb": {
        "en": "Which sums collapse into one term and which stay open. Conjoining — forcing 2+3x into 5x — is the classic closure error.",
        "de": "Welche Summen sich zu einem Term zusammenfassen lassen und welche offen bleiben. Ungleichartige Terme zusammenzuzwingen — $2+3x$ zu $5x$ — ist der klassische Abschlussfehler."
      },
      "skills": [
        {
          "id": "equivalence.number-plus-term",
          "name": {
            "en": "A number plus a term stays open",
            "de": "Zahl plus Term bleibt offen"
          },
          "note": {
            "en": "$2 + 3x$ is a finished object. Only like terms combine ($x + x = 2x$); $2$ and $3x$ are not like.",
            "de": "$2 + 3x$ ist ein fertiges Objekt. Nur gleichartige Terme lassen sich zusammenfassen ($x + x = 2x$); $2$ und $3x$ sind nicht gleichartig."
          },
          "illustration": "2 + 3x = 3x + 2",
          "wrong": [
            {
              "latex": "2 + 3x = 5x",
              "explains": "anti.conjoining"
            }
          ],
          "requires": [
            "equivalence.repeated-addition"
          ],
          "rules": [
            "rule.juxtaposition"
          ],
          "restsOn": [
            "th.collect-like-terms",
            "ix.juxtaposition"
          ]
        },
        {
          "id": "equivalence.unlike-variable-terms",
          "name": {
            "en": "Terms with different variables stay open",
            "de": "Terme mit verschiedenen Variablen bleiben offen"
          },
          "note": {
            "en": "$3x + 2y$ cannot combine into one term — $x$ and $y$ are different objects. $5xy$ would be a product, something else entirely.",
            "de": "$3x + 2y$ lässt sich nicht zu einem Term zusammenfassen — $x$ und $y$ sind verschiedene Objekte. $5xy$ wäre ein Produkt, also etwas ganz anderes."
          },
          "illustration": "3x + 2y = 2y + 3x",
          "wrong": [
            {
              "latex": "3x + 2y = 5xy",
              "explains": "anti.conjoining"
            }
          ],
          "requires": [
            "equivalence.number-plus-term"
          ],
          "rules": [
            "rule.juxtaposition"
          ],
          "restsOn": [
            "th.collect-like-terms",
            "ix.juxtaposition"
          ]
        },
        {
          "id": "equivalence.adding-powers",
          "name": {
            "en": "A power plus a term stays open",
            "de": "Potenz plus Term bleibt offen"
          },
          "note": {
            "en": "$x^2 + x$ has two unlike terms. Exponents grow when powers are multiplied ($x^2 \\cdot x = x^3$), never when they are added.",
            "de": "$x^2 + x$ hat zwei ungleichartige Terme. Exponenten wachsen beim Multiplizieren von Potenzen ($x^2 \\cdot x = x^3$), nie beim Addieren."
          },
          "illustration": "x^2 + x = x + x^2",
          "wrong": [
            {
              "latex": "x^2 + x = x^3",
              "explains": "anti.conjoining"
            }
          ],
          "requires": [
            "equivalence.exponent-as-repeated-product",
            "equivalence.number-plus-term"
          ],
          "restsOn": [
            "th.collect-like-terms"
          ]
        }
      ]
    },
    {
      "slug": "minus-sign",
      "title": {
        "en": "The Minus Sign",
        "de": "Das Minuszeichen"
      },
      "blurb": {
        "en": "One notation, two distinct roles: subtraction and negation. (A minus before a bracket is negation, which by -1x = -x you may read as multiply-by-(-1) - a theorem, not a third role.) The single highest-priority group.",
        "de": "Ein Zeichen, zwei verschiedene Rollen: Subtraktion und Negation. (Ein Minus vor einer Klammer ist Negation, die man wegen $-1x = -x$ als Multiplikation mit $-1$ lesen darf — ein Satz, keine dritte Rolle.) Die wichtigste Gruppe überhaupt."
      },
      "skills": [
        {
          "id": "equivalence.negative-numbers",
          "name": {
            "en": "Negative numbers and the unary minus",
            "de": "Negative Zahlen und das unäre Minus"
          },
          "note": {
            "en": "A negative number and its parenthesised form are the same object: -3 and (-3) are identical, and both equal 0 - 3.",
            "de": "Eine negative Zahl und ihre eingeklammerte Form sind dasselbe Objekt: $-3$ und $(-3)$ sind identisch, und beide sind $0 - 3$."
          },
          "illustration": "-3 = (-3) = 0 - 3",
          "wrong": [
            {
              "latex": "0 - 3 = 3 - 0",
              "explains": "anti.commute-everything"
            }
          ],
          "rules": [
            "rule.three-minuses"
          ],
          "restsOn": [
            "def.sub",
            "th.negative-one-times"
          ]
        },
        {
          "id": "equivalence.subtraction-as-adding-opposite",
          "name": {
            "en": "Subtracting vs. adding a negative",
            "de": "Subtrahieren und das Negative addieren"
          },
          "note": {
            "en": "Subtracting is the same as adding the opposite: a - b = a + (-b). The minus and the number belong together.",
            "de": "Subtrahieren ist dasselbe wie das Gegenteil addieren: $a - b = a + (-b)$. Das Minus gehört zur Zahl."
          },
          "illustration": "a - b = a + (-b) = a + (-1) \\cdot b",
          "wrong": [
            {
              "latex": "a - b = a \\cdot (-b)",
              "explains": "mis.subtraction-as-times-negative"
            },
            {
              "latex": "a + -b = a + (-b)",
              "explains": "omi.adjacent-signs"
            }
          ],
          "requires": [
            "equivalence.coefficient-negative-one"
          ],
          "rules": [
            "rule.three-minuses"
          ],
          "restsOn": [
            "def.sub",
            "th.negative-one-times"
          ]
        },
        {
          "id": "equivalence.minus-over-sum",
          "name": {
            "en": "Distributing a negative over a sum",
            "de": "Ein Minus über eine Summe verteilen"
          },
          "note": {
            "en": "A minus in front of a bracket means multiply the whole bracket by $-1$, so it hits every term inside: $-(a+b) = (-1)(a+b) = -a - b$.",
            "de": "Ein Minus vor einer Klammer heisst: die ganze Klammer mal $-1$, also trifft es jeden Term darin: $-(a+b) = (-1)(a+b) = -a - b$."
          },
          "illustration": "-(a + b) = (-1)(a + b) = -a - b",
          "wrong": [
            {
              "latex": "-(a + b) = -a + b",
              "explains": "anti.partial-distribution"
            }
          ],
          "requires": [
            "equivalence.coefficient-negative-one"
          ],
          "rules": [
            "rule.three-minuses",
            "rule.implicit-op-before-bracket"
          ],
          "restsOn": [
            "th.minus-over-sum",
            "th.negative-one-times",
            "def.sub",
            "ix.brackets"
          ]
        },
        {
          "id": "equivalence.minus-over-difference",
          "name": {
            "en": "Distributing a negative over a difference",
            "de": "Ein Minus über eine Differenz verteilen"
          },
          "note": {
            "en": "The minus flips the sign of every term inside the bracket: $-(a-b) = -a+b$.",
            "de": "Das Minus kehrt das Vorzeichen jedes Terms in der Klammer um: $-(a-b) = -a+b$."
          },
          "illustration": "-(a - b) = -a + b = b - a",
          "wrong": [
            {
              "latex": "-(a - b) = -a - b",
              "explains": "anti.partial-distribution"
            }
          ],
          "requires": [
            "equivalence.coefficient-negative-one"
          ],
          "rules": [
            "rule.three-minuses",
            "rule.implicit-op-before-bracket"
          ],
          "restsOn": [
            "th.minus-over-sum",
            "th.negative-one-times",
            "def.sub",
            "ix.brackets"
          ]
        },
        {
          "id": "equivalence.double-negative",
          "name": {
            "en": "Double negative",
            "de": "Doppeltes Minus"
          },
          "note": {
            "en": "Two minuses make a plus: subtracting a negative adds. (Likewise $-(-a) = a$.)",
            "de": "Zwei Minus ergeben ein Plus: ein Negatives zu subtrahieren heisst addieren. (Ebenso $-(-a) = a$.)"
          },
          "illustration": "a - (-b) = a + b",
          "wrong": [
            {
              "latex": "a - (-b) = a - b",
              "explains": "mis.minus-roles-confused"
            },
            {
              "latex": "a - -b = a - (-b)",
              "explains": "omi.adjacent-signs"
            }
          ],
          "requires": [
            "equivalence.subtraction-as-adding-opposite"
          ],
          "rules": [
            "rule.three-minuses"
          ],
          "restsOn": [
            "def.sub",
            "th.minus-in-product",
            "th.negative-one-times"
          ]
        },
        {
          "id": "equivalence.negative-times-negative",
          "name": {
            "en": "Negative times negative",
            "de": "Minus mal Minus"
          },
          "note": {
            "en": "A negative times a negative is positive. (One negative factor gives a negative: $(-a)(b) = -ab$.)",
            "de": "Minus mal Minus ist positiv. (Ein einzelner negativer Faktor ergibt ein Negatives: $(-a)(b) = -ab$.)"
          },
          "illustration": "(-a)(-b) = ab",
          "wrong": [
            {
              "latex": "(-a)(-b) = -ab",
              "explains": "mis.minus-roles-confused"
            }
          ],
          "requires": [
            "equivalence.negative-numbers",
            "equivalence.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.juxtaposition",
            "rule.three-minuses"
          ],
          "restsOn": [
            "th.minus-in-product",
            "ix.juxtaposition",
            "th.negative-one-times",
            "def.sub"
          ]
        },
        {
          "id": "equivalence.minus-on-fraction",
          "name": {
            "en": "Minus in front of a fraction",
            "de": "Minus vor einem Bruch"
          },
          "note": {
            "en": "A single minus on a fraction can sit out front, on the numerator, or on the denominator — all equal. Moving it to both at once cancels it.",
            "de": "Ein einzelnes Minus an einem Bruch darf vorne, beim Zähler oder beim Nenner stehen — alles gleichwertig. Setzt man es an beide Stellen, hebt es sich auf."
          },
          "illustration": "-\\frac{a}{b} = \\frac{-a}{b} = \\frac{a}{-b}",
          "wrong": [
            {
              "latex": "-\\frac{a}{b} = \\frac{-a}{-b}",
              "explains": "anti.minus-on-both-parts"
            }
          ],
          "requires": [
            "equivalence.negative-numbers",
            "equivalence.division-variants"
          ],
          "rules": [
            "rule.three-minuses",
            "rule.fraction-minus-moves",
            "rule.fraction-bar-brackets"
          ],
          "restsOn": [
            "th.fraction-minus-moves",
            "th.negative-one-times",
            "def.sub",
            "ix.fraction-bar"
          ]
        },
        {
          "id": "equivalence.subtracting-a-sum",
          "name": {
            "en": "Subtracting a bracketed sum",
            "de": "Eine geklammerte Summe subtrahieren"
          },
          "note": {
            "en": "The minus hits every term inside, not just the first. Same rule as $-(b+c)$, now with a term in front — recognising that the leading term does not shield the rest is the discrimination here.",
            "de": "Das Minus trifft jeden Term darin, nicht nur den ersten. Dieselbe Regel wie bei $-(b+c)$, nur mit einem Term davor — zu erkennen, dass der vordere Term den Rest nicht schützt, ist hier das Entscheidende."
          },
          "illustration": "a - (b + c) = a - b - c",
          "wrong": [
            {
              "latex": "a - (b + c) = a - b + c",
              "explains": "anti.partial-distribution"
            }
          ],
          "requires": [
            "equivalence.minus-over-sum"
          ],
          "rules": [
            "rule.three-minuses",
            "rule.implicit-op-before-bracket"
          ],
          "restsOn": [
            "th.subtract-a-sum",
            "th.negative-one-times",
            "def.sub",
            "ix.brackets"
          ]
        },
        {
          "id": "equivalence.subtracting-a-difference",
          "name": {
            "en": "Subtracting a bracketed difference",
            "de": "Eine geklammerte Differenz subtrahieren"
          },
          "note": {
            "en": "The minus flips every sign inside: $a - (b-c) = a - b + c$. The leading term makes the missed sign-flip on the second term especially easy to overlook.",
            "de": "Das Minus kehrt jedes Vorzeichen darin um: $a - (b-c) = a - b + c$. Der vordere Term macht es besonders leicht, den Wechsel beim zweiten Term zu übersehen."
          },
          "illustration": "a - (b - c) = a - b + c",
          "wrong": [
            {
              "latex": "a - (b - c) = a - b - c",
              "explains": "anti.partial-distribution"
            }
          ],
          "requires": [
            "equivalence.minus-over-difference"
          ],
          "rules": [
            "rule.three-minuses",
            "rule.implicit-op-before-bracket"
          ],
          "restsOn": [
            "th.subtract-a-sum",
            "th.negative-one-times",
            "def.sub",
            "ix.brackets"
          ]
        }
      ]
    },
    {
      "slug": "brackets",
      "title": {
        "en": "Brackets",
        "de": "Klammern"
      },
      "skills": [
        {
          "id": "equivalence.bracket-types",
          "name": {
            "en": "Bracket types are interchangeable",
            "de": "Klammerarten sind austauschbar"
          },
          "note": {
            "en": "Round, square, and curly brackets group in exactly the same way: (a+b), [a+b] and {a+b} are identical.",
            "de": "Runde, eckige und geschweifte Klammern gruppieren genau gleich: $(a+b)$, $[a+b]$ und $\\{a+b\\}$ sind identisch."
          },
          "illustration": "(a + b) = [a + b] = \\{a + b\\}",
          "restsOn": [
            "ix.brackets"
          ]
        },
        {
          "id": "equivalence.redundant-brackets",
          "name": {
            "en": "Redundant brackets",
            "de": "Überflüssige Klammern"
          },
          "note": {
            "en": "Brackets around something already whole can be dropped: ((a+b)) = (a+b) = a+b, and (x) = x.",
            "de": "Klammern um etwas, das schon ein Ganzes ist, darf man weglassen: $((a+b)) = (a+b) = a+b$, und $(x) = x$."
          },
          "illustration": "((a + b)) = (a + b) = a + b",
          "wrong": [
            {
              "latex": "((a + b)) \\neq (a + b)",
              "explains": "omi.redundant-brackets-kept"
            }
          ],
          "restsOn": [
            "ix.brackets"
          ]
        },
        {
          "id": "equivalence.precedence-brackets",
          "name": {
            "en": "Brackets and order of operations",
            "de": "Klammern und Reihenfolge der Operationen"
          },
          "note": {
            "en": "Multiplication happens before addition: $a + b \\cdot c$ means $a + (b \\cdot c)$. A bracket changes the meaning: $(a+b) \\cdot c$ is different.",
            "de": "Mal kommt vor plus: $a + b \\cdot c$ bedeutet $a + (b \\cdot c)$. Eine Klammer ändert die Bedeutung: $(a+b) \\cdot c$ ist etwas anderes."
          },
          "illustration": "a + b \\cdot c = a + bc",
          "wrong": [
            {
              "latex": "a + b \\cdot c = (a + b) \\cdot c",
              "explains": "mis.precedence-ignored"
            }
          ],
          "requires": [
            "equivalence.explicit-vs-implicit-product"
          ],
          "restsOn": [
            "ix.precedence",
            "ix.brackets"
          ]
        },
        {
          "id": "equivalence.fraction-bar-grouping",
          "name": {
            "en": "Implicit brackets in the fraction bar",
            "de": "Unsichtbare Klammern im Bruchstrich"
          },
          "note": {
            "en": "The fraction bar groups the whole numerator: $(a+b)/c$ is all of $a+b$ over $c$.",
            "de": "Der Bruchstrich fasst den ganzen Zähler zusammen: $(a+b)/c$ ist ganz $a+b$ durch $c$."
          },
          "illustration": "\\frac{a+b}{c} = (a+b) \\div c",
          "wrong": [
            {
              "latex": "\\frac{a+b}{c} = a + \\frac{b}{c}",
              "explains": "mis.fraction-bar-grouping-lost"
            },
            {
              "latex": "a + b/c = \\frac{a+b}{c}",
              "explains": "mis.linear-slash-overgrouped"
            }
          ],
          "conditions": "c \\ne 0",
          "requires": [
            "equivalence.division-variants"
          ],
          "rules": [
            "rule.fraction-bar-brackets"
          ],
          "restsOn": [
            "ix.fraction-bar"
          ]
        },
        {
          "id": "equivalence.multiplying-into-a-bracket",
          "name": {
            "en": "Multiplying into a bracket",
            "de": "In eine Klammer hineinmultiplizieren"
          },
          "note": {
            "en": "Multiplication distributes to every term inside: the 2 hits both the $x$ and the 1.",
            "de": "Die Multiplikation verteilt sich auf jeden Term darin: die 2 trifft sowohl das $x$ als auch die 1."
          },
          "illustration": "2(x + 1) = 2x + 2",
          "wrong": [
            {
              "latex": "2(x + 1) = 2x + 1",
              "explains": "anti.partial-distribution"
            }
          ],
          "requires": [
            "equivalence.product-with-brackets"
          ],
          "rules": [
            "rule.implicit-op-before-bracket",
            "rule.only-multiplication-distributes"
          ],
          "restsOn": [
            "ax.distributivity",
            "ix.juxtaposition",
            "ix.brackets"
          ]
        }
      ]
    },
    {
