[
  {
    "kind": "equivalence",
    "id": "equivalence.addition-commutative",
    "group": "commutativity",
    "name": "Addition is commutative",
    "note": "Order does not matter for addition: a + b = b + a.",
    "illustration": "a + b = b + a",
    "restsOn": [
      "ax.add-commutative"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.multiplication-commutative",
    "group": "commutativity",
    "name": "Multiplication is commutative",
    "note": "Order does not matter for multiplication: ab = ba.",
    "illustration": "ab = ba",
    "requires": [
      "equivalence.explicit-vs-implicit-product"
    ],
    "metaPatterns": [
      "meta.juxtaposition"
    ],
    "restsOn": [
      "ax.mul-commutative",
      "ix.juxtaposition"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.subtraction-not-commutative",
    "group": "commutativity",
    "name": "Subtraction is not commutative",
    "note": "Subtraction does not commute: a - b is not b - a. But flipping the order flips the sign: a - b = -(b - a).",
    "illustration": "a - b = -(b - a)",
    "requires": [
      "equivalence.minus-over-difference"
    ],
    "metaPatterns": [
      "meta.three-minuses"
    ],
    "restsOn": [
      "def.sub",
      "th.negative-one-times"
    ],
    "errors": [
      "anti.commute-everything"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.division-not-commutative",
    "group": "commutativity",
    "name": "Division is not commutative",
    "note": "Division does not commute: a/b is not b/a. Swapping numerator and denominator gives the reciprocal, not the same value.",
    "illustration": "a \\div b = \\frac{a}{b}",
    "requires": [
      "equivalence.division-variants"
    ],
    "restsOn": [
      "def.div",
      "ix.division-symbols"
    ],
    "errors": [
      "anti.commute-everything"
    ]
  }
]
