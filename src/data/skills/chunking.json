{
  "kind": "chunking",
  "title": {
    "en": "Chunking",
    "de": "Zerlegen"
  },
  "blurb": {
    "en": "Breaking a term into its top-level operands.",
    "de": "Einen Term in seine obersten Bestandteile zerlegen."
  },
  "groups": [
    {
      "slug": "chunking",
      "title": {
        "en": "Chunking",
        "de": "Zerlegen"
      },
      "skills": [
        {
          "id": "chunking.chunks-in-sum",
          "name": {
            "en": "Chunks in a sum or difference",
            "de": "Blöcke in einer Summe oder Differenz"
          },
          "note": {
            "en": "Break at the $+$ and $-$ signs, keeping each sign with its term. Each product like $3x$ stays whole.",
            "de": "Bei den $+$ und $-$ trennen und jedes Zeichen bei seinem Term lassen. Jedes Produkt wie $3x$ bleibt ganz."
          },
          "illustration": "3x + 2y - z",
          "chunks": [
            "3x",
            "2y",
            "-z"
          ],
          "misChunks": [
            "3",
            "x",
            "2",
            "y",
            "z"
          ],
          "requires": [
            "equivalence.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.multiplication-binds-tighter"
          ],
          "restsOn": [
            "ix.precedence",
            "ix.juxtaposition",
            "def.sub"
          ],
          "errors": [
            "sal.implicit-op-overlooked"
          ]
        },
        {
          "id": "chunking.chunks-in-product",
          "name": {
            "en": "Chunks in a product",
            "de": "Blöcke in einem Produkt"
          },
          "note": {
            "en": "Break at the multiplication points. Each bracket is one factor.",
            "de": "An den Malpunkten trennen. Jede Klammer ist ein Faktor."
          },
          "illustration": "3 \\cdot x \\cdot (x+1)",
          "chunks": [
            "3",
            "x",
            "(x+1)"
          ],
          "requires": [
            "equivalence.product-with-brackets"
          ],
          "rules": [
            "rule.bracket-chunk"
          ],
          "restsOn": [
            "ix.brackets",
            "ix.precedence",
            "op.mul"
          ]
        },
        {
          "id": "chunking.implicit-chunking",
          "name": {
            "en": "Implicit chunking — multiplication precedence",
            "de": "Unsichtbare Blöcke — Vorrang der Multiplikation"
          },
          "note": {
            "en": "No brackets, yet the chunks are $3x$ and $2y$: the $\\cdot$ is used up inside each term.",
            "de": "Keine Klammern, und doch sind die Blöcke $3x$ und $2y$: das $\\cdot$ ist innerhalb jedes Terms schon aufgebraucht."
          },
          "illustration": "3x + 2y",
          "chunks": [
            "3x",
            "2y"
          ],
          "misChunks": [
            "3x + 2",
            "y"
          ],
          "requires": [
            "equivalence.precedence-brackets"
          ],
          "rules": [
            "rule.dominant-op-last"
          ],
          "restsOn": [
            "ax.add-associative",
            "ax.add-commutative",
            "ix.precedence"
          ],
          "errors": [
            "mis.precedence-ignored"
          ]
        },
        {
          "id": "chunking.bracket-as-chunk",
          "name": {
            "en": "Bracket as a single chunk",
            "de": "Klammer als ein einziger Block"
          },
          "note": {
            "en": "Resist expanding — treat the whole bracket as one object.",
            "de": "Nicht ausmultiplizieren — die ganze Klammer als ein Objekt behandeln."
          },
          "illustration": "3(x+1) - 2(x-1)",
          "chunks": [
            "3(x+1)",
            "2(x-1)"
          ],
          "requires": [
            "equivalence.product-with-brackets"
          ],
          "rules": [
            "rule.bracket-chunk"
          ],
          "restsOn": [
            "ix.brackets",
            "ix.juxtaposition",
            "def.sub"
          ],
          "errors": [
            "anti.bracket-dissolved"
          ]
        }
      ]
    }
  ]
}
