[
  {
    "kind": "chunking",
    "skill": "chunking.chunks-in-sum",
    "examples": [
      {
        "expr": "3x + 2y - z",
        "chunks": [
          "3x",
          "2y",
          "-z"
        ],
        "op": "sum"
      },
      {
        "expr": "ab - cd + ef",
        "chunks": [
          "ab",
          "-cd",
          "ef"
        ],
        "op": "sum"
      }
    ],
    "pitfalls": [
      {
        "chunks": [
          "3",
          "x",
          "2y",
          "z"
        ],
        "why": "splitting 3x into 3 and x instead of keeping the product as one chunk",
        "explainedBy": [
          "sal.implicit-op-overlooked"
        ]
      }
    ]
  },
  {
    "kind": "chunking",
    "skill": "chunking.chunks-in-product",
    "examples": [
      {
        "expr": "3 \\cdot x \\cdot (x+1)",
        "chunks": [
          "3",
          "x",
          "(x+1)"
        ],
        "op": "product"
      },
      {
        "expr": "2x(x-1)(x+2)",
        "chunks": [
          "2",
          "x",
          "(x-1)",
          "(x+2)"
        ],
        "op": "product"
      }
    ],
    "pitfalls": []
  },
  {
    "kind": "chunking",
    "skill": "chunking.implicit-chunking",
    "examples": [
      {
        "expr": "3x + 2y",
        "chunks": [
          "3x",
          "2y"
        ],
        "op": "sum"
      },
      {
        "expr": "a^2 b + a b^2",
        "chunks": [
          "a^2 b",
          "a b^2"
        ],
        "op": "sum"
      }
    ],
    "pitfalls": [
      {
        "chunks": [
          "3",
          "x",
          "2",
          "y"
        ],
        "why": "not reading the implicit multiplication that binds 3 and x into one chunk",
        "explainedBy": [
          "mis.precedence-ignored"
        ]
      }
    ]
  },
  {
    "kind": "chunking",
    "skill": "chunking.bracket-as-chunk",
    "examples": [
      {
        "expr": "3(x+1) - 2(x-1)",
        "chunks": [
          "3(x+1)",
          "2(x-1)"
        ],
        "op": "difference"
      },
      {
        "expr": "(x+1)(x-1)",
        "chunks": [
          "(x+1)",
          "(x-1)"
        ],
        "op": "product"
      }
    ],
    "pitfalls": [
      {
        "chunks": [
          "3",
          "x",
          "1",
          "2",
          "x",
          "1"
        ],
        "why": "expanding the brackets instead of keeping each as one chunk",
        "explainedBy": [
          "anti.bracket-dissolved"
        ]
      }
    ]
  }
]
