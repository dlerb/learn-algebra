{
  "process": "chunking",
  "title": {
    "en": "Chunking",
    "de": "Zerlegen"
  },
  "blurb": {
    "en": "Reading the structure — the dominant operation and the parts it joins.",
    "de": "Die Struktur lesen — die Hauptoperation und die Bausteine, die sie verbindet."
  },
  "groups": [
    {
      "slug": "basic-forms",
      "title": {
        "en": "The Five Basic Forms",
        "de": "Die fünf Grundformen"
      },
      "blurb": {
        "en": "Recognition in unambiguous cases. Foundation before the misleading forms.",
        "de": "Erkennen in eindeutigen Fällen. Das Fundament vor den irreführenden Formen."
      },
      "skills": [
        {
          "id": "skill.sum",
          "name": {
            "en": "Sum",
            "de": "Summe"
          },
          "note": {
            "en": "Dominant op = the outermost $+$; its terms are the chunks.",
            "de": "Hauptoperation = das äusserste $+$; seine Summanden sind die Bausteine."
          },
          "stimulus": "a + b",
          "right": [
            {
              "latex": "(a) + (b)"
            }
          ],
          "requires": [
            "skill.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.dominant-op-last"
          ],
          "restsOn": [
            "ax.add-associative",
            "ax.add-commutative",
            "ix.precedence"
          ],
          "reversible": true
        },
        {
          "id": "skill.difference",
          "name": {
            "en": "Difference",
            "de": "Differenz"
          },
          "note": {
            "en": "The last operation applied is subtraction. The chunks are the two terms.",
            "de": "Die zuletzt ausgeführte Operation ist die Subtraktion. Die Bausteine sind die beiden Terme."
          },
          "stimulus": "a - b",
          "right": [
            {
              "latex": "(a) - (b)"
            }
          ],
          "requires": [
            "skill.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.dominant-op-last"
          ],
          "restsOn": [
            "def.sub",
            "ix.precedence"
          ],
          "reversible": true
        },
        {
          "id": "skill.product",
          "name": {
            "en": "Product",
            "de": "Produkt"
          },
          "note": {
            "en": "Dominant op = the outermost $\\cdot$; its factors are the chunks.",
            "de": "Hauptoperation = das äusserste $\\cdot$; seine Faktoren sind die Bausteine."
          },
          "stimulus": "ab",
          "right": [
            {
              "latex": "(a) \\cdot (b)"
            }
          ],
          "requires": [
            "skill.explicit-vs-implicit-product",
            "skill.product-with-brackets"
          ],
          "rules": [
            "rule.dominant-op-last"
          ],
          "restsOn": [
            "ax.mul-associative",
            "ax.mul-commutative",
            "ix.juxtaposition",
            "ix.brackets",
            "ix.precedence"
          ],
          "reversible": true
        },
        {
          "id": "skill.quotient",
          "name": {
            "en": "Quotient",
            "de": "Quotient"
          },
          "note": {
            "en": "The last operation applied is division. The chunks are numerator and denominator.",
            "de": "Die zuletzt ausgeführte Operation ist die Division. Die Bausteine sind Zähler und Nenner."
          },
          "stimulus": "\\frac{a}{b}",
          "right": [
            {
              "latex": "\\frac{(a)}{(b)}"
            }
          ],
          "requires": [
            "skill.division-variants"
          ],
          "rules": [
            "rule.dominant-op-last"
          ],
          "restsOn": [
            "def.div",
            "ix.fraction-bar",
            "ix.precedence"
          ],
          "reversible": true
        },
        {
          "id": "skill.power",
          "name": {
            "en": "Power",
            "de": "Potenz"
          },
          "note": {
            "en": "Dominant op = the power; base and exponent are the chunks.",
            "de": "Hauptoperation = die Potenz; Basis und Exponent sind die Bausteine."
          },
          "stimulus": "a^2",
          "right": [
            {
              "latex": "(a)^{(2)}"
            }
          ],
          "requires": [
            "skill.exponent-as-repeated-product"
          ],
          "rules": [
            "rule.dominant-op-last"
          ],
          "restsOn": [
            "def.pow",
            "ix.pow",
            "th.negative-base"
          ],
          "reversible": true
        }
      ]
    },
    {
      "slug": "misleading-forms",
      "title": {
        "en": "Misleading Surface Forms",
        "de": "Irreführende Oberflächenformen"
      },
      "blurb": {
        "en": "Where a visible operation distracts from the dominant one. The core of Skill 2.",
        "de": "Wo eine sichtbare Operation von der Hauptoperation ablenkt. Der Kern von Stufe 2."
      },
      "skills": [
        {
          "id": "skill.sum-of-products",
          "name": {
            "en": "Sum of products — multiplication is inside the terms",
            "de": "Summe von Produkten — die Multiplikation steckt in den Termen"
          },
          "note": {
            "en": "The multiplications are inside the terms, already done. The last operation applied to the whole expression is addition — a sum.",
            "de": "Die Multiplikationen stecken in den Termen und sind schon erledigt. Die zuletzt auf den ganzen Ausdruck angewandte Operation ist die Addition — also eine Summe."
          },
          "stimulus": "3x + 2y",
          "right": [
            {
              "latex": "(3x) + (2y)"
            }
          ],
          "wrong": [
            {
              "latex": "3x + 2y = (3x) \\cdot (2y)",
              "mistake": "sal.loudest-op-wins"
            }
          ],
          "requires": [
            "skill.sum",
            "skill.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.multiplication-binds-tighter"
          ],
          "restsOn": [
            "ix.precedence",
            "ix.juxtaposition",
            "op.add"
          ],
          "reversible": true
        },
        {
          "id": "skill.product-with-inner-sum",
          "name": {
            "en": "Product containing a sum — looks like a sum",
            "de": "Produkt mit einer Summe darin — sieht aus wie eine Summe"
          },
          "note": {
            "en": "The $+$ is trapped inside a chunk (the bracket). The dominant operation is the multiplication outside — a product.",
            "de": "Das $+$ steckt in einem Baustein (der Klammer) fest. Die Hauptoperation ist die Multiplikation aussen — also ein Produkt."
          },
          "stimulus": "3(x+1)",
          "right": [
            {
              "latex": "(3) \\cdot (x+1)"
            }
          ],
          "wrong": [
            {
              "latex": "3(x+1) = (3) + (x+1)",
              "mistake": "sal.loudest-op-wins"
            }
          ],
          "requires": [
            "skill.product",
            "skill.product-with-brackets"
          ],
          "rules": [
            "rule.bracket-chunk"
          ],
          "restsOn": [
            "ix.brackets",
            "ix.precedence"
          ],
          "reversible": true
        },
        {
          "id": "skill.coefficient-times-power",
          "name": {
            "en": "Coefficient in front of a power",
            "de": "Koeffizient vor einer Potenz"
          },
          "note": {
            "en": "$2x^2$ is $2 \\cdot (x^2)$, not $(2x)^2$. The exponent grabs only the $x$; the dominant operation is the product of $2$ and $x^2$.",
            "de": "$2x^2$ ist $2 \\cdot (x^2)$, nicht $(2x)^2$. Der Exponent packt nur das $x$; die Hauptoperation ist das Produkt aus $2$ und $x^2$."
          },
          "stimulus": "2x^2",
          "right": [
            {
              "latex": "(2) \\cdot (x^2)"
            }
          ],
          "wrong": [
            {
              "latex": "2x^2 = (2x)^{2}",
              "mistake": "mis.exponent-scope"
            }
          ],
          "requires": [
            "skill.product",
            "skill.power-of-a-product"
          ],
          "rules": [],
          "restsOn": [
            "ix.pow",
            "th.negative-base"
          ],
          "reversible": true
        },
        {
          "id": "skill.leading-minus",
          "name": {
            "en": "Expression with a leading minus",
            "de": "Ausdruck mit führendem Minus"
          },
          "note": {
            "en": "A leading minus is just the sign of the first term — it does not make the whole thing a subtraction. $-3x + 2y$ is a sum. (A leading minus can also sit on a power, e.g. $-(x+1)^2$, which is a power then negated.)",
            "de": "Ein führendes Minus ist nur das Vorzeichen des ersten Terms — es macht das Ganze nicht zu einer Subtraktion. $-3x + 2y$ ist eine Summe. (Ein führendes Minus kann auch an einer Potenz stehen, etwa $-(x+1)^2$, das ist eine Potenz und dann negiert.)"
          },
          "stimulus": "-3x + 2y",
          "right": [
            {
              "latex": "(-3x) + (2y)"
            }
          ],
          "wrong": [
            {
              "latex": "-3x + 2y = (3x) - (2y)",
              "mistake": "mis.minus-roles-confused"
            }
          ],
          "requires": [
            "skill.sum-of-products",
            "skill.coefficient-negative-one"
          ],
          "rules": [],
          "restsOn": [
            "ix.precedence",
            "def.sub",
            "ix.coefficient-front"
          ],
          "reversible": true
        },
        {
          "id": "skill.power-with-inner-sum",
          "name": {
            "en": "Power containing a sum",
            "de": "Potenz mit einer Summe darin"
          },
          "note": {
            "en": "The base is the whole chunk (x+1). The dominant operation is the power.",
            "de": "Die Basis ist der ganze Baustein $(x+1)$. Die Hauptoperation ist die Potenz."
          },
          "stimulus": "(x+1)^2",
          "right": [
            {
              "latex": "(x+1)^{(2)}"
            }
          ],
          "wrong": [
            {
              "latex": "(x+1)^2 = (x) + (1)^{2}",
              "mistake": "sal.loudest-op-wins"
            }
          ],
          "requires": [
            "skill.power",
            "skill.product-with-inner-sum",
            "skill.exponent-as-repeated-product"
          ],
          "rules": [],
          "restsOn": [
            "ix.brackets",
            "ix.pow",
            "ix.power-precedence"
          ],
          "reversible": true
        },
        {
          "id": "skill.complex-quotient",
          "name": {
            "en": "Quotient with a complex numerator or denominator",
            "de": "Quotient mit zusammengesetztem Zähler oder Nenner"
          },
          "note": {
            "en": "The sums are inside the chunks (numerator and denominator). The whole thing is a division — a quotient.",
            "de": "Die Summen stecken in den Bausteinen (Zähler und Nenner). Das Ganze ist eine Division — also ein Quotient."
          },
          "stimulus": "\\frac{3x+2}{x-1}",
          "right": [
            {
              "latex": "\\frac{(3x+2)}{(x-1)}"
            }
          ],
          "wrong": [
            {
              "latex": "\\frac{3x+2}{x-1} = (3x) + \\frac{2}{x-1}",
              "mistake": "sal.loudest-op-wins"
            }
          ],
          "requires": [
            "skill.quotient",
            "skill.fraction-bar-grouping"
          ],
          "rules": [
            "rule.bracket-chunk"
          ],
          "restsOn": [
            "ix.fraction-bar",
            "ix.brackets",
            "def.div"
          ],
          "reversible": true
        }
      ]
    },
    {
      "slug": "finding-the-parts",
      "title": {
        "en": "Chunking",
        "de": "Zerlegen"
      },
      "skills": [
        {
          "id": "skill.chunks-in-sum",
          "name": {
            "en": "Chunks in a sum or difference",
            "de": "Bausteine in einer Summe oder Differenz"
          },
          "note": {
            "en": "Break at the $+$ and $-$ signs, keeping each sign with its term. Each product like $3x$ stays whole.",
            "de": "Bei den $+$ und $-$ trennen und jedes Zeichen bei seinem Term lassen. Jedes Produkt wie $3x$ bleibt ganz."
          },
          "stimulus": "3x + 2y - z",
          "right": [
            {
              "latex": "(3x) + (2y) + (-z)"
            }
          ],
          "wrong": [
            {
              "latex": "3x + 2y - z = (3) + (x) + (2) + (y) + (z)",
              "mistake": "sal.implicit-op-overlooked"
            }
          ],
          "requires": [
            "skill.explicit-vs-implicit-product"
          ],
          "rules": [
            "rule.multiplication-binds-tighter"
          ],
          "restsOn": [
            "ix.precedence",
            "ix.juxtaposition",
            "def.sub"
          ],
          "reversible": true
        },
        {
          "id": "skill.chunks-in-product",
          "name": {
            "en": "Chunks in a product",
            "de": "Bausteine in einem Produkt"
          },
          "note": {
            "en": "Break at the multiplication points. Each bracket is one factor.",
            "de": "An den Malpunkten trennen. Jede Klammer ist ein Faktor."
          },
          "stimulus": "3 \\cdot x \\cdot (x+1)",
          "right": [
            {
              "latex": "(3) \\cdot (x) \\cdot (x+1)"
            }
          ],
          "requires": [
            "skill.product-with-brackets"
          ],
          "rules": [
            "rule.bracket-chunk"
          ],
          "restsOn": [
            "ix.brackets",
            "ix.precedence",
            "op.mul"
          ],
          "reversible": true
        },
        {
          "id": "skill.implicit-chunking",
          "name": {
            "en": "Implicit chunking — multiplication precedence",
            "de": "Unsichtbare Bausteine — Vorrang der Multiplikation"
          },
          "note": {
            "en": "No brackets, yet the chunks are $3x$ and $2y$: the $\\cdot$ is used up inside each term.",
            "de": "Keine Klammern, und doch sind die Bausteine $3x$ und $2y$: das $\\cdot$ ist innerhalb jedes Terms schon aufgebraucht."
          },
          "stimulus": "3x + 2y",
          "right": [
            {
              "latex": "(3x) + (2y)"
            }
          ],
          "wrong": [
            {
              "latex": "3x + 2y = 5xy",
              "mistake": "anti.conjoining"
            }
          ],
          "requires": [
            "skill.precedence-brackets"
          ],
          "rules": [
            "rule.multiplication-binds-tighter"
          ],
          "restsOn": [
            "ax.add-associative",
            "ax.add-commutative",
            "ix.precedence"
          ],
          "reversible": true
        },
        {
          "id": "skill.bracket-as-chunk",
          "name": {
            "en": "Bracket as a single chunk",
            "de": "Klammer als ein einziger Baustein"
          },
          "note": {
            "en": "Resist expanding — treat the whole bracket as one object.",
            "de": "Nicht ausmultiplizieren — die ganze Klammer als ein Objekt behandeln."
          },
          "stimulus": "3(x+1) - 2(x-1)",
          "right": [
            {
              "latex": "(3(x+1)) - (2(x-1))"
            }
          ],
          "wrong": [
            {
              "latex": "3(x+1) - 2(x-1) = (3x + 1) + (-2x - 1)",
              "mistake": "anti.bracket-dissolved"
            }
          ],
          "requires": [
            "skill.product-with-brackets"
          ],
          "rules": [
            "rule.bracket-chunk"
          ],
          "restsOn": [
            "ix.brackets",
            "ix.juxtaposition",
            "def.sub"
          ],
          "reversible": true
        }
      ]
    },
    {
      "slug": "familiar-shapes",
      "title": {
        "en": "Familiar Shapes",
        "de": "Bekannte Gestalten"
      },
      "skills": [
        {
          "id": "skill.common-factor",
          "name": {
            "en": "Common factor",
            "de": "Gemeinsamer Faktor"
          },
          "note": {
            "en": "Dominant operation: a sum. The shape is special: all chunks share a factor (3, a, 2x, (x+1)). Recognising it unlocks factoring it out.",
            "de": "Hauptoperation: eine Summe. Die Gestalt ist besonders: alle Bausteine haben einen Faktor gemeinsam ($3$, $a$, $2x$, $(x+1)$). Sie zu erkennen eröffnet das Ausklammern."
          },
          "stimulus": "3x + 6",
          "right": [
            {
              "latex": "(3x) + (6)"
            }
          ],
          "requires": [
            "skill.sum-of-products"
          ],
          "rules": [
            "rule.dominant-op-tools"
          ],
          "restsOn": [
            "ix.precedence",
            "ix.juxtaposition",
            "op.add"
          ],
          "reversible": true
        },
        {
          "id": "skill.quadratic-form",
          "name": {
            "en": "Quadratic form",
            "de": "Quadratische Form"
          },
          "note": {
            "en": "Dominant operation: a sum. Highest power is 2 — the quadratic shape. Recognising it gates all of quadratic algebra.",
            "de": "Hauptoperation: eine Summe. Höchste Potenz ist 2 — die quadratische Gestalt. Sie zu erkennen ist das Tor zur ganzen quadratischen Algebra."
          },
          "stimulus": "x^2 + 3x + 2",
          "right": [
            {
              "latex": "(x^2) + (3x) + (2)"
            }
          ],
          "requires": [
            "skill.sum-of-products"
          ],
          "rules": [
            "rule.dominant-op-tools"
          ],
          "restsOn": [
            "ix.precedence",
            "ix.pow",
            "op.add"
          ],
          "reversible": true
        }
      ]
    }
  ]
}
