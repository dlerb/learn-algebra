[
  {
    "kind": "equivalence",
    "id": "equivalence.number-plus-term",
    "group": "like-terms",
    "title": "A number plus a term stays open",
    "priority": 11,
    "requires": ["equivalence.repeated-addition"],
    "metaPatterns": ["meta.juxtaposition"],
    "justifiedBy": ["thm.collect-like-terms"],
    "governedBy": ["conv.juxtaposition"],
    "note": "$2 + 3x$ is a finished object — it does not collapse to $5x$. Only like terms combine ($x + x = 2x$); $2$ and $3x$ are not like.",
    "equivalents": ["2 + 3x", "3x + 2"],
    "pitfalls": [{ "expr": "5x", "explainedBy": ["anti.conjoining"] }]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.unlike-variable-terms",
    "group": "like-terms",
    "title": "Terms with different variables stay open",
    "priority": 12,
    "requires": ["equivalence.number-plus-term"],
    "metaPatterns": ["meta.juxtaposition"],
    "justifiedBy": ["thm.collect-like-terms"],
    "governedBy": ["conv.juxtaposition"],
    "note": "3x + 2y cannot combine into one term — x and y are different objects. 5xy would be a product, something else entirely.",
    "equivalents": ["3x + 2y", "2y + 3x"],
    "pitfalls": [{ "expr": "5xy", "explainedBy": ["anti.conjoining"] }]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.adding-powers",
    "group": "like-terms",
    "title": "A power plus a term stays open",
    "priority": 13,
    "requires": ["equivalence.exponent-as-repeated-product", "equivalence.number-plus-term"],
    "metaPatterns": [],
    "justifiedBy": ["thm.collect-like-terms"],
    "note": "$x^2 + x$ has two unlike terms — it is not $x^3$. Exponents grow when powers are multiplied ($x^2 \\cdot x = x^3$), never when they are added.",
    "equivalents": ["x^2 + x", "x + x^2"],
    "pitfalls": [{ "expr": "x^3", "explainedBy": ["anti.conjoining"] }]
  }
]
