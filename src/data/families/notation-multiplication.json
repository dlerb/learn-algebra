    "governedBy": ["conv.invisible-one", "conv.juxtaposition"],
    "note": "An invisible coefficient of -1 means negate: (-1)a, -1a and -a are the same object. (Similarly a coefficient of 1 is invisible: 1x = x.)",
    "equivalents": ["(-1) \\cdot a", "(-1)a", "-1a", "-a"],
    "pitfalls": [{ "expr": "-1 + a", "explainedBy": ["mis.juxtaposition-as-plus"] }]
