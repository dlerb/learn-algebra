[
  {
    "kind": "equivalence",
    "id": "notation.explicit-vs-implicit-product",
    "group": "multiplication",
    "title": "Explicit vs. implicit multiplication",
    "priority": 1,
    "metaPatterns": ["meta.juxtaposition"],
    "governedBy": ["conv.juxtaposition", "conv.canonical-order"],
    "note": "Symbols next to each other, or joined by $\\cdot$ or $\\times$, all mean multiply. $3x$ is a product — not a two-digit number, and not $3 + x$.",
    "equivalents": ["3 \\times x", "3 \\cdot x", "3x", "x \\cdot 3", "(3)(x)"],
    "pitfalls": [{ "expr": "3 + x", "explainedBy": ["mis.juxtaposition-as-plus"] }]
  },
  {
    "kind": "equivalence",
    "id": "notation.product-with-brackets",
    "group": "multiplication",
    "title": "Multiplication with brackets",
    "priority": 14,
    "requires": ["notation.explicit-vs-implicit-product"],
    "metaPatterns": ["meta.juxtaposition", "meta.implicit-op-before-bracket"],
    "governedBy": ["conv.juxtaposition", "conv.brackets-group"],
    "note": "A number against a bracket means multiply: 2(x+1) is 2 times (x+1), not 2 + (x+1).",
    "equivalents": ["2 \\times (x+1)", "2 \\cdot (x+1)", "2(x+1)", "(x+1) \\cdot 2"],
    "pitfalls": [{ "expr": "2 + (x+1)", "explainedBy": ["mis.juxtaposition-as-plus"] }]
  },
