[
  {
    "kind": "chunking",
    "id": "structure.chunks-in-sum",
    "group": "chunking",
    "title": "Chunks in a sum or difference",
    "requires": ["notation.explicit-vs-implicit-product"],
    "metaPatterns": ["meta.multiplication-binds-tighter"],
    "note": "Break at the + and − signs, keeping each sign with its term. Each product like 3x stays whole.",
    "examples": [
      { "expr": "3x + 2y - z", "chunks": ["3x", "2y", "-z"], "op": "sum" },
      { "expr": "ab - cd + ef", "chunks": ["ab", "-cd", "ef"], "op": "sum" }
    ],
    "pitfalls": [
      { "chunks": ["3", "x", "2y", "z"], "why": "splitting 3x into 3 and x instead of keeping the product as one chunk" }
    ]
  },
  {
    "kind": "chunking",
    "id": "structure.chunks-in-product",
    "group": "chunking",
    "title": "Chunks in a product",
    "requires": ["notation.product-with-brackets"],
    "metaPatterns": ["meta.bracket-chunk"],
    "note": "Break at the multiplication points. Each bracket is one factor.",
    "examples": [
      { "expr": "3 \\cdot x \\cdot (x+1)", "chunks": ["3", "x", "(x+1)"], "op": "product" },
      { "expr": "2x(x-1)(x+2)", "chunks": ["2", "x", "(x-1)", "(x+2)"], "op": "product" }
    ],
    "pitfalls": []
  },
  {
    "kind": "chunking",
    "id": "structure.implicit-chunking",
    "group": "chunking",
    "title": "Implicit chunking — multiplication precedence",
    "priority": 8,
    "requires": ["notation.precedence-brackets"],
    "metaPatterns": ["meta.multiplication-binds-tighter"],
    "note": "There are no brackets, but multiplication binds tighter than +. Read the implicit chunks: 3x and 2y.",
    "examples": [
      { "expr": "3x + 2y", "chunks": ["3x", "2y"], "op": "sum" },
      { "expr": "a^2 b + a b^2", "chunks": ["a^2 b", "a b^2"], "op": "sum" }
    ],
    "pitfalls": [
      { "chunks": ["3", "x", "2", "y"], "why": "not reading the implicit multiplication that binds 3 and x into one chunk" }
    ]
  },
  {
    "kind": "chunking",
    "id": "structure.bracket-as-chunk",
    "group": "chunking",
    "title": "Bracket as a single chunk",
    "priority": 8,
    "requires": ["notation.product-with-brackets"],
    "metaPatterns": ["meta.bracket-chunk"],
    "note": "Resist expanding — treat the whole bracket as one object.",
    "examples": [
      { "expr": "3(x+1) - 2(x-1)", "chunks": ["3(x+1)", "2(x-1)"], "op": "difference" },
      { "expr": "(x+1)(x-1)", "chunks": ["(x+1)", "(x-1)"], "op": "product" }
    ],
    "pitfalls": [
      { "chunks": ["3", "x", "1", "2", "x", "1"], "why": "expanding the brackets instead of keeping each as one chunk" }
    ]
  }
]
