    "group": "exponents",
    "title": "Root of a product",
    "priority": 27,
    "conditions": "a ≥ 0, b ≥ 0",
    "requires": ["notation.explicit-vs-implicit-product"],
    "metaPatterns": ["M6"],
    "note": "A root splits over ×: √(ab) = √a · √b.",
    "equivalents": ["\\sqrt{ab}", "\\sqrt{a} \\cdot \\sqrt{b}"],
    "pitfalls": []
  },
  {
    "kind": "equivalence",
    "id": "notation.root-of-a-sum",
    "group": "exponents",
    "title": "Root of a sum",
    "priority": 28,
    "conditions": "a ≥ 0, b ≥ 0",
    "requires": ["notation.root-of-a-product"],
    "metaPatterns": ["M6"],
    "note": "A root does NOT split over +: √(a+b) is not √a + √b. Try a = 9, b = 16: √25 = 5, but 3 + 4 = 7.",
    "equivalents": ["\\sqrt{a+b}", "\\sqrt{b+a}"],
    "pitfalls": ["\\sqrt{a} + \\sqrt{b}"]
  }
