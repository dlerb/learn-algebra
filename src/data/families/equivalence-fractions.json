[
  {
    "kind": "equivalence",
    "id": "equivalence.division-variants",
    "group": "fractions",
    "title": "Division notation variants",
    "priority": 19,
    "note": "Division has many faces: $a \\div b = a : b = a/b$. All the same object. (The colon is the primary-school division sign.)",
    "illustration": "a \\div b = a : b = \\frac{a}{b}",
    "conditions": "b \\ne 0",
    "governedBy": [
      "conv.division-signs"
    ],
    "errors": [
      "anti.commute-everything"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.fraction-as-reciprocal-product",
    "group": "fractions",
    "title": "Fraction as multiplication by a reciprocal",
    "note": "Dividing by $b$ is multiplying by $1/b$: $a/b = a \\cdot (1/b)$. This is why dividing by a fraction means multiplying by its reciprocal.",
    "illustration": "\\frac{a}{b} = a \\cdot \\frac{1}{b}",
    "conditions": "b \\ne 0",
    "requires": [
      "equivalence.division-variants"
    ],
    "justifiedBy": [
      "def.division"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.divide-by-one",
    "group": "fractions",
    "title": "Dividing by 1",
    "note": "Dividing by 1 changes nothing: a/1 = a.",
    "illustration": "\\frac{a}{1} = a",
    "requires": [
      "equivalence.division-variants"
    ],
    "justifiedBy": [
      "thm.divide-by-one"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.splitting-a-fraction",
    "group": "fractions",
    "title": "Splitting a fraction over addition",
    "priority": 25,
    "note": "You may split a sum in the numerator: (a+b)/c = a/c + b/c. You may NOT split the denominator: a/(b+c) is not a/b + a/c.",
    "illustration": "\\frac{a+b}{c} = \\frac{a}{c} + \\frac{b}{c}",
    "conditions": "c \\ne 0",
    "requires": [
      "equivalence.fraction-bar-grouping"
    ],
    "metaPatterns": [
      "meta.fraction-bar-brackets",
      "meta.only-multiplication-distributes"
    ],
    "justifiedBy": [
      "thm.split-numerator",
      "ax.distributivity"
    ],
    "governedBy": [
      "conv.fraction-bar"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.no-splitting-the-denominator",
    "group": "fractions",
    "title": "A sum in the denominator does not split",
    "priority": 26,
    "note": "Splitting works over the numerator only. $c/(a+b)$ is $c$ divided by the whole chunk $a+b$ — it is not $c/a + c/b$. (Check with numbers: $12/(2+4) = 2$, but $12/2 + 12/4 = 9$.)",
    "illustration": "\\frac{c}{a+b} = c \\div (a+b)",
    "conditions": "a+b \\ne 0",
    "requires": [
      "equivalence.splitting-a-fraction"
    ],
    "metaPatterns": [
      "meta.fraction-bar-brackets",
      "meta.only-multiplication-distributes"
    ],
    "justifiedBy": [
      "thm.split-numerator"
    ],
    "governedBy": [
      "conv.fraction-bar"
    ],
    "errors": [
      "anti.linearity"
    ]
  },
  {
    "kind": "equivalence",
    "id": "equivalence.no-cancelling-in-a-sum",
    "group": "fractions",
    "title": "No cancelling inside a sum",
    "priority": 27,
    "note": "You cannot cancel the 3 against one term of the numerator: $(3x+2)/3 = x + 2/3$, not $x + 2$. Cancelling needs a common factor of the WHOLE numerator.",
    "illustration": "\\frac{3x+2}{3} = x + \\frac{2}{3}",
    "requires": [
